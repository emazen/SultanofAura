PAYLOAD_SECRET=change-me
DATABASE_URL=postgres://shop:shop@localhost/sultanofaura
COMPANY_NAME="Sultan of Aura"
SITE_NAME="Sultan of Aura"
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=demo-draft-secret
# Havale / EFT details shown at checkout
BANK_NAME="Örnek Banka"
BANK_ACCOUNT_HOLDER="Sultan of Aura"
BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"
# Trendyol seller API (for scripts/import-trendyol.ts)
TRENDYOL_SUPPLIER_ID=1190557
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# iyzico (kart ödemesi) — sandbox anahtarları sandbox-merchant.iyzipay.com'dan alınır
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Taksit seçenekleri; tek çekim için 1 bırakın (örn. 1,2,3,6)
IYZICO_ENABLED_INSTALLMENTS=1
# Perakende müşteride TCKN toplamıyoruz; iyzico zorunlu alan için varsayılan
IYZICO_DEFAULT_IDENTITY_NUMBER=11111111111
# Kart ödemesini checkout'ta göstermek için "true" yapın (anahtarlar hazır olduğunda)
NEXT_PUBLIC_IYZICO_ENABLED=false
